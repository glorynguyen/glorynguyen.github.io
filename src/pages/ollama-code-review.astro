        .nav-brand { display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 1.25rem; text-decoration: none; color: var(--color-text); }
        .nav-links { display: flex; list-style: none; gap: 24px; align-items: center; }
        .nav-links a { text-decoration: none; color: var(--color-text-light); font-weight: 500; transition: color 0.2s; }
        .nav-links a:hover { color: var(--color-primary); }
        .nav-cta { background: var(--color-primary); color: white !important; padding: 8px 20px; border-radius: 8px; }

        /* Hero Section */
        .hero { background: var(--color-bg-dark); color: white; padding: 120px 0 160px; position: relative; }
        .hero-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 60px; align-items: center; }
        .hero-badge { display: inline-block; background: rgba(0, 122, 204, 0.2); border: 1px solid var(--color-primary); color: #60a5fa; padding: 6px 16px; border-radius: 100px; font-weight: 600; font-size: 0.875rem; margin-bottom: 24px; }
        .hero h1 { font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 800; line-height: 1.1; margin-bottom: 24px; letter-spacing: -0.04em; }
        .hero h1 span { background: linear-gradient(to right, #60a5fa, #34d399, #fbbf24); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hero p { font-size: 1.25rem; color: #94a3b8; margin-bottom: 40px; max-width: 600px; }

        /* Stats Bar */
        .stats-bar { display: flex; gap: 40px; margin-top: 48px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 32px; }
        .stat-item { display: flex; flex-direction: column; }
        .stat-value { font-size: 1.5rem; font-weight: 700; color: white; }
        .stat-label { font-size: 0.875rem; color: #64748b; }

        /* Visual Window */
        .window-mockup { background: #1e293b; border-radius: var(--radius-lg); border: 1px solid #334155; box-shadow: var(--shadow-xl); overflow: hidden; }
        .window-header { background: #0f172a; padding: 12px 16px; display: flex; gap: 8px; }
        .dot { width: 12px; height: 12px; border-radius: 50%; }
        .window-content { padding: 24px; font-family: 'Fira Code', monospace; font-size: 0.875rem; color: #cbd5e1; }
        .ai-tag { color: var(--color-secondary); font-weight: bold; }

        /* Providers */
        .providers { padding: 80px 0; background: var(--color-bg-alt); text-align: center; }
        .provider-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 32px; margin-top: 40px; opacity: 0.7; }
        .provider-list span { font-weight: 600; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; }

        /* Features Section */
        .features { padding: 120px 0; }
        .section-tag { color: var(--color-primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; display: block; text-align: center; margin-bottom: 16px; }
        .section-title { font-size: 2.5rem; font-weight: 800; text-align: center; margin-bottom: 64px; }
        
        .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 32px; }
        .feature-card { padding: 40px; border-radius: var(--radius-lg); border: 1px solid var(--color-border); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); background: white; }
        .feature-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-xl); border-color: var(--color-primary); }
        .feature-card i { font-size: 2rem; color: var(--color-primary); margin-bottom: 24px; display: block; }
        .feature-card h3 { font-size: 1.5rem; margin-bottom: 16px; font-weight: 700; }
        .feature-card p { color: var(--color-text-light); font-size: 1rem; }
        .feature-card .badge { display: inline-block; padding: 4px 12px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; background: #dcfce7; color: #166534; margin-bottom: 12px; }

        /* Feature Categories (Tier 2) */
        .feature-categories { padding: 40px 0 80px; }
        .feature-category { padding: 40px 0; border-bottom: 1px solid var(--color-border); }
        .feature-category:last-child { border-bottom: none; }
        .feature-category h3 { font-size: 1.3rem; font-weight: 700; color: var(--color-text); margin-bottom: 24px; padding-bottom: 12px; border-bottom: 2px solid var(--color-primary); display: inline-block; }
        .feature-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 32px; }
        .feature-list-item { display: flex; gap: 12px; align-items: flex-start; padding: 8px 0; }
        .feature-list-item svg { flex-shrink: 0; margin-top: 3px; }
        .feature-list-item div { display: flex; flex-direction: column; }
        .feature-list-item strong { font-weight: 600; font-size: 0.95rem; color: var(--color-text); }
        .feature-list-item span { font-size: 0.85rem; color: var(--color-text-light); margin-top: 2px; }

        /* Advanced AI Section */
        .advanced-ai { background: #0f172a; color: white; padding: 120px 0; }
        .ai-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
        .ai-content h2 { font-size: 3rem; font-weight: 800; margin-bottom: 24px; }
        .ai-feature-list { list-style: none; margin-top: 32px; }
        .ai-feature-list li { margin-bottom: 24px; display: flex; gap: 16px; }
        .ai-feature-list b { color: #60a5fa; display: block; font-size: 1.1rem; }

        /* Dashboard Section */
        .dashboard-preview { padding: 100px 0; text-align: center; }
        .dashboard-img { width: 100%; max-width: 1000px; border-radius: 20px; box-shadow: var(--shadow-xl); margin-top: 48px; border: 4px solid white; }

        /* CTA */
        .cta-section { padding: 120px 0; text-align: center; background: linear-gradient(135deg, var(--color-primary), #4f46e5); color: white; }
        .cta-section h2 { font-size: 3.5rem; font-weight: 800; margin-bottom: 24px; }
        .cta-btns { display: flex; justify-content: center; gap: 20px; margin-top: 40px; }
        .btn { padding: 16px 32px; border-radius: 12px; font-weight: 700; text-decoration: none; transition: all 0.2s; font-size: 1.1rem; }
        .btn-white { background: white; color: var(--color-primary); }
        .btn-white:hover { transform: scale(1.05); }

        /* Footer */
        footer { background: #020617; color: #94a3b8; padding: 80px 0 40px; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 60px; margin-bottom: 60px; }
        .footer-brand h2 { color: white; margin-bottom: 20px; }
        .footer-links h4 { color: white; margin-bottom: 24px; text-transform: uppercase; font-size: 0.875rem; letter-spacing: 0.1em; }
        .footer-links ul { list-style: none; }
        .footer-links li { margin-bottom: 12px; }
        .footer-links a { color: inherit; text-decoration: none; transition: color 0.2s; }
        .footer-links a:hover { color: white; }

        /* Responsive */
