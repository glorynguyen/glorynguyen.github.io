---
interface Props {
    title: string;
    description: string;
    keywords?: string;
    ogType?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogUrl?: string;
    ogImage?: string;
    ogImageAlt?: string;
    twitterCard?: string;
    canonicalUrl?: string;
    structuredData?: object;
    preloadImage?: string;
}

const {
    title,
    description,
    keywords,
    ogType = 'website',
    ogTitle,
    ogDescription,
    ogUrl,
    ogImage,
    ogImageAlt,
    twitterCard = 'summary',
    canonicalUrl,
    structuredData,
    preloadImage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    {keywords && <meta name="keywords" content={keywords}>}
    <meta name="author" content="Vinh Nguyen (Vincent)">
    <meta name="robots" content="index, follow">

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}>
    {ogTitle && <meta property="og:title" content={ogTitle}>}
    {ogDescription && <meta property="og:description" content={ogDescription}>}
    {ogUrl && <meta property="og:url" content={ogUrl}>}
    {ogImage && <meta property="og:image" content={ogImage}>}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt}>}

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard}>
    {ogTitle && <meta name="twitter:title" content={ogTitle}>}
    {ogDescription && <meta name="twitter:description" content={ogDescription}>}
    {ogImage && <meta name="twitter:image" content={ogImage}>}
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt}>}

    <!-- Canonical URL -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl}>}

    {preloadImage && <link rel="preload" href={preloadImage} as="image" type="image/webp" />}

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#2563eb">

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Vinh Nguyen (Vincent) - Blog" href="/rss.xml">

    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Structured Data -->
    {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <slot name="head" />
</head>
<body>
    <slot />
    <script is:inline>
      // Initialize chatbot flag and Vincent context before chatbot script loads
      window.__vnbChatWithVincentLoaded = window.__vnbChatWithVincentLoaded || false;
      window.__vnbVincentContext = "You are Vincent (Vinh Nguyen), a Front-End Technical Lead with over 10 years of experience. You answer questions as if you ARE Vincent — friendly, professional, and knowledgeable. Speak in first person. Keep answers concise but informative. If someone asks something you don't know about Vincent's personal life, politely say you'd rather keep that private.\n\nABOUT ME:\nI'm Vinh Nguyen, also known as Vincent. I'm a Front-End Technical Lead with a deep passion for building high-performance web applications. With a strong foundation in computer science, algorithms, and performance optimization, I specialize in creating scalable, accessible, and SEO-friendly web solutions. I'm based in Vietnam. My portfolio is at vinhnguyenba.dev.\n\nCURRENT ROLE:\nFrontend Technical Lead at Huge (August 2025 - Present), working on PepsiCo's Global Platform.\n- Architecting core front-end systems including Global Search (OpenSearch) and build-time redirect framework for 200+ markets\n- Using Next.js 15, React 19, Sitecore JSS, GraphQL, TypeScript, OpenSearch\n- Led migration to Next.js v15 and React v19 with Core Web Vitals optimization\n- Established engineering standards for TypeScript, component modularity, and CI/CD\n- Enforced WCAG accessibility standards and automated quality gates\n\nPREVIOUS EXPERIENCE:\n1. Front-End Lead at Astek Vietnam - Decathlon E-commerce (Aug 2023 - Aug 2025) - Led front-end for Decathlon's e-commerce, scaling from Singapore to APAC. Next.js, React, TypeScript.\n2. Full Stack Leader at Syntrino Solutions (Feb 2020 - Aug 2023) - Led team for Malaysian company. Built attendance tracking, shift scheduler, voice detection. Next.js, React Native, .NET Core.\n3. Senior Application Developer at PERSOL (Apr 2019 - Feb 2020) - R&D team, AI chatbots, PWA. Integrated Azure QnA Maker and TensorFlow.\n4. Senior Front-End Developer at Appable (Aug 2017 - Apr 2019) - Startup, best employee of the year. Pioneered React adoption.\n5. Front-End Developer at Seldat Distribution (Aug 2016 - Aug 2017) - AngularJS apps.\n6. Software Engineer at Global CyberSoft (Oct 2014 - Aug 2016) - Started career in R&D Big Data.\n\nTECHNICAL SKILLS:\n- Leadership: Technical Architecture, Team Mentoring, Sprint Planning, Code Reviews, Stakeholder Communication\n- Frontend: React, Next.js, Angular, React Native, Vue.js, Astro, PWA\n- Languages: TypeScript, JavaScript, HTML5, CSS3, GraphQL\n- Performance: Core Web Vitals, ISR, SSG, SSR, WebAssembly, WebGPU\n- CMS: Sitecore XP/JSS, ContentStack, Headless CMS, Bynder DAM\n- DevOps: CI/CD, Git, Azure, Docker\n- AI: MCP Servers, Azure QnA, TensorFlow, Chatbots\n\nLEADERSHIP PHILOSOPHY:\n1. Team Enablement - Build autonomous teams through mentorship\n2. Technical Excellence - Drive standards through code reviews and learning\n3. Impact-Driven Delivery - Measurable business value\n4. Cross-Functional Collaboration - Bridge design, product, and engineering\n\nSIDE PROJECTS:\n- Ollama Code Review (VS Code Extension), GitSage (MCP Server), Confluence MCP, GSAP Master MCP, Figma CSS Diff (Chrome Extension), TL Estimation Workbench, Cheryx.com, Video Compressor, Free Craft Patterns, Oil Reminder\n\nCAREER HIGHLIGHTS: 10+ years leading teams, 50+ engineers mentored, Led PepsiCo platform for 200+ markets, 5+ enterprise projects as Tech Lead.";
    </script>
    <script is:inline src="/chatbot/vnb-chatbot.js"></script>
    <script is:inline>
      (function() {
        // Skip if already initialized (e.g. on chatbot-demo page)
        if (window.__vnbChatWithVincentLoaded) return;
        window.__vnbChatWithVincentLoaded = true;

        window.VNBChatbot.init({
          id: "chat-with-vincent-global",
          position: "bottom-right",
          title: "Chat with Vincent",
          subtitle: "Local AI · Private",
          placeholder: "Ask Vincent anything...",
          welcomeMessage: "Hey! I'm Vincent — a Front-End Technical Lead with 10+ years of experience. Ask me about my work, skills, or projects. Everything runs locally in your browser!",
          systemPrompt: window.__vnbVincentContext,
          inference: {
            mode: "auto",
            fallbackToRemote: false,
            fallbackToWasm: true
          },
          local: {
            model: "Llama-3.2-1B-Instruct-q4f32_1-MLC",
            cacheBackend: "indexeddb",
            moduleUrl: "https://esm.run/@mlc-ai/web-llm",
            stream: true,
            temperature: 0.3,
            topP: 0.9,
            preloadOnInit: false
          },
          wasm: {
            model: "onnx-community/Qwen2.5-0.5B-Instruct",
            moduleUrl: "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.0.2",
            dtype: "q4",
            device: "wasm",
            stream: true,
            temperature: 0.3,
            topP: 0.9,
            maxNewTokens: 256,
            preloadOnInit: false
          },
          maxHistoryMessages: 10,
          persistConversation: true,
          labels: {
            open: "Chat with Vincent",
            close: "Close",
            send: "Send",
            loading: "Thinking...",
            clear: "Clear chat"
          },
          theme: {
            accent: "#2563eb",
            accentHover: "#1d4ed8",
            panelBg: "#ffffff",
            text: "#0f172a",
            muted: "#64748b"
          }
        }).then(function(bot) {
          window.__vnbChatInstances = window.__vnbChatInstances || {};
          window.__vnbChatInstances["chat-with-vincent-global"] = bot;

          // Reflect the chosen backend in the subtitle for transparency.
          if (typeof bot.getBackendOrder === "function" && typeof bot.updateSubtitle === "function") {
            var first = bot.getBackendOrder()[0];
            if (first === "wasm") {
              bot.updateSubtitle("Local Lite · Private");
            } else if (first === "local") {
              bot.updateSubtitle("Local AI · Private");
            } else if (!first) {
              bot.updateSubtitle("Chat unavailable on this device");
            }
          }
        }).catch(function(err) {
          console.warn("Chat widget init failed:", err.message);
        });
      })();
    </script>
</body>
</html>
