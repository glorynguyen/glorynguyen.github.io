---
// Reusable email subscription form
// Uses Buttondown's HTML form API
---

<section class="subscribe-section" aria-labelledby="subscribe-heading">
    <div class="subscribe-card">
        <div class="subscribe-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
        </div>

        <h3 id="subscribe-heading" class="subscribe-title" data-lang="en">
            Stay updated
        </h3>
        <p class="subscribe-description" data-lang="en">
            Get notified when I publish new posts. No spam, unsubscribe anytime.
        </p>

        <h3 class="subscribe-title" data-lang="vi" hidden>
            Cập nhật bài viết mới
        </h3>
        <p class="subscribe-description" data-lang="vi" hidden>
            Nhận thông báo khi có bài viết mới. Không spam, hủy đăng ký bất cứ lúc nào.
        </p>

        <form
            action="https://buttondown.com/api/emails/embed-subscribe/ba_vinh"
            method="post"
            target="popupwindow"
            class="subscribe-form"
        >
            <div class="subscribe-input-group">
                <label for="bd-email" class="sr-only">Email address</label>
                <input
                    type="email"
                    name="email"
                    id="bd-email"
                    required
                    class="subscribe-input"
                    placeholder="your@email.com"
                    data-placeholder-en="your@email.com"
                    data-placeholder-vi="email@cuaban.com"
                />
                <button type="submit" class="subscribe-button">
                    <span data-lang="en">Subscribe</span>
                    <span data-lang="vi" hidden>Đăng ký</span>
                </button>
            </div>
        </form>

        <p class="subscribe-rss">
            <a href="/rss.xml" class="rss-link" data-lang="en">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 11a9 9 0 0 1 9 9"></path>
                    <path d="M4 4a16 16 0 0 1 16 16"></path>
                    <circle cx="5" cy="19" r="1"></circle>
                </svg>
                Or subscribe via RSS
            </a>
            <a href="/rss.xml" class="rss-link" data-lang="vi" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 11a9 9 0 0 1 9 9"></path>
                    <path d="M4 4a16 16 0 0 1 16 16"></path>
                    <circle cx="5" cy="19" r="1"></circle>
                </svg>
                Hoặc đăng ký qua RSS
            </a>
        </p>
    </div>
</section>

<script is:inline>
    window.addEventListener('languagechange', function(e) {
        var input = document.getElementById('bd-email');
        if (input && e.detail && e.detail.language) {
            var placeholder = input.getAttribute('data-placeholder-' + e.detail.language);
            if (placeholder) input.placeholder = placeholder;
        }
    });
</script>

<style>
    .subscribe-section {
        margin: 3rem 0 0 0;
        padding-top: 2.5rem;
        border-top: 1px solid var(--color-border);
    }

    .subscribe-card {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.05), rgba(16, 185, 129, 0.05));
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 2rem;
        text-align: center;
        max-width: 500px;
        margin: 0 auto;
    }

    .subscribe-icon {
        color: var(--color-primary);
        margin-bottom: 1rem;
    }

    .subscribe-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0 0 0.5rem 0;
    }

    .subscribe-description {
        font-size: 0.9rem;
        color: var(--color-text-light);
        margin: 0 0 1.5rem 0;
        line-height: 1.5;
    }

    .subscribe-form {
        margin: 0;
    }

    .subscribe-input-group {
        display: flex;
        gap: 0.5rem;
        max-width: 400px;
        margin: 0 auto;
    }

    .subscribe-input {
        flex: 1;
        padding: 0.625rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        font-size: 0.875rem;
        font-family: inherit;
        background: var(--color-bg);
        color: var(--color-text);
        transition: border-color 0.2s ease;
    }

    .subscribe-input:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .subscribe-button {
        padding: 0.625rem 1.25rem;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: var(--radius);
        font-size: 0.875rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.2s ease;
        white-space: nowrap;
    }

    .subscribe-button:hover {
        background: var(--color-primary-dark);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    .subscribe-rss {
        margin: 1rem 0 0 0;
        font-size: 0.8rem;
    }

    .rss-link {
        color: var(--color-text-light);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        transition: color 0.2s ease;
    }

    .rss-link:hover {
        color: var(--color-accent);
    }

    @media (max-width: 480px) {
        .subscribe-input-group {
            flex-direction: column;
        }

        .subscribe-button {
            width: 100%;
        }
    }
</style>
