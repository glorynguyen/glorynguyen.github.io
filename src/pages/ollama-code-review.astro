            .hero-grid, .ai-grid { grid-template-columns: 1fr; text-align: center; }
            .hero h1 { font-size: 3.5rem; }
            .stats-bar { justify-content: center; }
            .ai-feature-list li { text-align: left; }
            .feature-list { grid-template-columns: 1fr; }
        }
    </style>
</head>
