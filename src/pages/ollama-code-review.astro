            --color-v0: #000000;
            --color-text: #1f2937;
            --color-text-light: #6b7280;
            --color-bg: #ffffff;
            --color-bg-alt: #f9fafb;
            --color-bg-dark: #0f172a;
            --color-border: #e5e7eb;
            --shadow-xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            --radius-lg: 16px;
        }

        /* Base Reset */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; line-height: 1.6; color: var(--color-text); background-color: var(--color-bg); overflow-x: hidden; }

        .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

